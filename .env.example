# garmin-connect-mcp environment
# MCP loads .env from its launch working directory. Desktop clients should pass
# explicit env entries; never commit .env or session files.
GARMIN_USERNAME=your-email@example.com
GARMIN_ACCOUNT=default
# First login from the source checkout (set GARMIN_USERNAME in your shell):
# node lib/auth-cli.js serve --account default --open
# Garmin Connect China is selected automatically. Match the account alias and
# session-file destination in the MCP configuration.
# Password/MFA input belongs in the Garmin form within the local browser page.
# A second concurrent MCP process needs its own independently initialized alias.
#
# The default destination is under the platform config root:
# garmin-connect-mcp/accounts/<alias>.session.json
# For a custom destination, set this in MCP and use the same path with serve
# --output. Keep the directory private and local; do not share/copy refresh tokens.
# GARMIN_SESSION_TOKEN_FILE=/absolute/private/path/default.session.json

# Legacy credential alternatives, not needed for normal browser authentication:
# GARMIN_PASSWORD=
# GARMIN_SESSION_TOKEN=
# login --browser and canary retain optional Playwright diagnostics;
# normal serve uses the system browser without Playwright.

# Required only for FIT download. Choose a trusted absolute parent.
# Results use GARMIN_FIT_cn_<normalized-email>/<activityId>.fit.
# Existing files are not overwritten; tool results contain metadata only.
# GARMIN_FIT_DOWNLOAD_DIR=/absolute/path/to/garmin-fit-parent

# Absolute, local, private directory holding the account-scoped write journal
# (operations.json) and the write lock. Independent of GARMIN_ACCOUNT and the
# session file, so every alias for the same account shares one recovery record.
# Default: <platform config root>/garmin-connect-mcp/state
# Relative values are rejected. Deleting this directory destroys the records
# that prevent duplicate calendar writes; back it up instead of removing it.
# A journal with no archive refuses new writes past 32 MiB.
# GARMIN_STATE_DIR=/absolute/private/path/state

# Finite cache TTL in seconds (0 disables caching).
GARMIN_CACHE_TTL=300
# Request timeout in milliseconds, default 15000.
GARMIN_REQUEST_TIMEOUT_MS=15000
# debug | info | warn | error. Logs go to stderr, never MCP stdout.
GARMIN_LOG_LEVEL=info
# compact | full. Full may include precise routes/location.
GARMIN_ACTIVITY_DETAIL=compact
# Explicit live integration checks only; true prints normalized personal data.
GARMIN_INTEGRATION_VERBOSE=false
